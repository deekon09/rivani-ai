# RIVANI AI — security + indexing + safe caching
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: unsafe-none
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=(), microphone=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://apis.google.com https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com https://*.gstatic.com; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' https://rivani-account-api.rivani.workers.dev https://rivani-models.rivani.workers.dev https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.googleapis.com https://www.googleapis.com https://cdn.jsdelivr.net https://challenges.cloudflare.com https://rivani-ai.firebaseapp.com; frame-src https://challenges.cloudflare.com https://rivani-ai.firebaseapp.com https://accounts.google.com https://apis.google.com; manifest-src 'self'; upgrade-insecure-requests

/audio-repair.html
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none

/auth.html
  X-Robots-Tag: noindex, nofollow
/dashboard.html
  X-Robots-Tag: noindex, nofollow
/admin-payments.html
  X-Robots-Tag: noindex, nofollow
/pro.html
  X-Robots-Tag: noindex, nofollow
/calculator.html
  X-Robots-Tag: noindex, nofollow

# Keep the legacy workers.dev hostname accessible for old links,
# but prevent search engines from indexing that duplicate host.
# This absolute-URL rule does NOT apply to https://rivaniai.online/.
https://rivani-ai.rivani.workers.dev/*
  X-Robots-Tag: noindex

# Runtime config must never be pinned in the browser/CDN.
# It contains public environment configuration that can change after launch.
/assets/runtime-config.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Cache only stable media aggressively, not every file under /assets.
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/pro-access.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
# Beta control/contact scripts change frequently during testing.
/contact.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/contact.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/audio-repair.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/image-enhancer.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/background-remover.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
